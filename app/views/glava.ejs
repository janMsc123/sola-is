<!-- glava.ejs - vrh vsake strani: naslov in meni glede na vlogo -->
<!doctype html>
<html lang="sl">
<head>
  <meta charset="utf-8">
  <!-- da se stran prav prikaže na telefonu -->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= naslov %> | Šolski IS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<%
  // povezava v meniju; "aktivna" je, če smo na tej strani ali pod njo
  // (glavna stran /ucenec je aktivna tudi na /ucenec/predmet/..., ne pa na /ucenec/ocene)
  function meni(href, besedilo, tudi) {
    const aktivna = pot === href || (tudi || []).some(z => pot.startsWith(z));
    return '<a href="' + href + '"' + (aktivna ? ' class="aktivna"' : '') + '>' + besedilo + '</a>';
  }
%>

<header>
  <a href="/" class="logo">Šolski IS</a>

  <nav>
    <% if (!uporabnik) { %>
      <%- meni('/prijava', 'Prijava') %>
      <%- meni('/registracija', 'Registracija') %>

    <% } else if (uporabnik.vloga === 'administrator') { %>
      <%- meni('/admin', 'Pregled') %>
      <%- meni('/admin/razredi', 'Razredi', ['/admin/razredi/']) %>
      <%- meni('/admin/predmeti', 'Predmeti', ['/admin/predmeti/']) %>
      <%- meni('/admin/ucitelji', 'Učitelji', ['/admin/ucitelji/']) %>
      <%- meni('/admin/ucenci', 'Učenci', ['/admin/ucenci/']) %>

    <% } else if (uporabnik.vloga === 'ucitelj') { %>
      <%- meni('/ucitelj', 'Moji predmeti', ['/ucitelj/']) %>
      <%- meni('/koledar', 'Koledar') %>

    <% } else { %>
      <%- meni('/ucenec', 'Moji predmeti', ['/ucenec/predmet/', '/ucenec/naloga/', '/ucenec/potrdi/']) %>
      <%- meni('/koledar', 'Koledar') %>
      <%- meni('/ucenec/ocene', 'Ocene') %>
      <%- meni('/ucenec/predmeti', 'Izbira predmetov') %>
    <% } %>
  </nav>

  <% if (uporabnik) { %>
    <div class="uporabnik">
      <% if (uporabnik.vloga === 'ucenec') { %>
        <a href="/ucenec/profil" class="ime"><%= uporabnik.ime %></a>
      <% } else { %>
        <span class="ime"><%= uporabnik.ime %></span>
      <% } %>
      <a href="/odjava" class="gumb siv majhen">Odjava</a>
    </div>
  <% } %>
</header>

<main>
