<!-- koledar.ejs - mesečni koledar rokov (učitelj in učenec) -->
<%- include('glava', { naslov: 'Koledar' }) %>

<% const jeUcitelj = uporabnik.vloga === 'ucitelj'; %>
<% const povezava = n => (jeUcitelj ? '/ucitelj/naloga/' : '/ucenec/naloga/') + n.id; %>
<!-- barva naloge: pri učencu glede na to, ali je oddana; pri učitelju vedno modra -->
<% const barva = n => jeUcitelj ? '' : stanje(n, n.rok, zdaj).barva; %>

<div class="naslov-strani">
  <div class="koledar-glava">
    <h1><%= naslovMeseca %></h1>
  </div>
  <div class="vrstica">
    <a class="gumb siv" href="/koledar?mesec=<%= prejsnji %>" aria-label="Prejšnji mesec">←</a>
    <a class="gumb siv" href="/koledar">Danes</a>
    <a class="gumb siv" href="/koledar?mesec=<%= naslednji %>" aria-label="Naslednji mesec">→</a>
  </div>
</div>

<!-- mreža: en stolpec za vsak dan v tednu (na telefonu skrita, tam je spodnji seznam) -->
<div class="okvir koledar-mreza">
<div class="tabela">
<table class="koledar">
  <tr>
    <th>pon</th><th>tor</th><th>sre</th><th>čet</th><th>pet</th><th>sob</th><th>ned</th>
  </tr>
  <% for (const teden of tedni) { %>
  <tr>
    <% for (const d of teden) { %>
      <% if (!d) { %>
        <td class="prazen"></td>
      <% } else { %>
        <td class="<%= d.danes ? 'danes' : '' %>">
          <span class="dan"><%= d.dan %></span>
          <% for (const n of d.naloge) { %>
            <a class="dogodek <%= barva(n) %>" href="<%= povezava(n) %>"
               title="<%= n.predmet %>: <%= n.naslov %>">
              <%= n.predmet %><%= jeUcitelj ? ' ' + n.razred : '' %>
            </a>
          <% } %>
        </td>
      <% } %>
    <% } %>
  </tr>
  <% } %>
</table>
</div>
</div>

<!-- isti roki še kot seznam -->
<div class="okvir">
  <div class="okvir-glava"><h2>Roki v mesecu<span class="stevec"><%= naloge.length %></span></h2></div>
  <% if (naloge.length === 0) { %>
    <p class="prazno">Ta mesec ni rokov.</p>
  <% } else { %>
    <ul class="seznam">
      <% for (const n of naloge) { %>
        <li>
          <div class="glavno">
            <a href="<%= povezava(n) %>"><%= n.naslov %></a>
            <div class="drobno"><%= n.predmet %><%= jeUcitelj ? ' · ' + n.razred : '' %></div>
          </div>
          <% if (jeUcitelj) { %>
            <span class="desno"><%= n.st_oddaj %> oddaj</span>
          <% } else { %>
            <% const st = stanje(n, n.rok, zdaj); %>
            <span class="stanje <%= st.barva %>"><%= st.besedilo %></span>
          <% } %>
          <span class="desno"><%= datumUra(n.rok) %></span>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>

<%- include('noga') %>
