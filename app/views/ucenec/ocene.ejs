<!-- ucenec/ocene.ejs - vse moje ocene po predmetih s povprečjem -->
<%- include('../glava', { naslov: 'Moje ocene' }) %>

<div class="naslov-strani">
  <div>
    <h1>Ocene</h1>
    <% if (cakajo > 0) { %><p class="podnaslov"><%= cakajo %> oddaj čaka na oceno</p><% } %>
  </div>
</div>

<% if (predmeti.length === 0) { %>
  <div class="okvir"><p class="prazno">Nimate še nobene ocene.</p></div>
<% } %>

<% for (const p of predmeti) { %>
<div class="okvir">
  <div class="okvir-glava">
    <h2><%= p.predmet %></h2>
    <span class="povprecje">povprečje <b><%= p.povprecje %></b></span>
  </div>
  <div class="tabela">
  <table>
    <tr><th>Naloga</th><th>Ocena</th><th>Komentar</th><th>Datum</th></tr>
    <% for (const o of p.ocene) { %>
    <tr>
      <td>
        <% if (o.naloga_id) { %>
          <a href="/ucenec/naloga/<%= o.naloga_id %>"><%= o.naslov %></a>
        <% } else { %>
          <a href="/ucenec/oddaja/<%= o.id %>"><%= o.ime_datoteke %></a>
        <% } %>
      </td>
      <td><span class="ocena"><%= o.ocena %></span></td>
      <td><%= o.komentar || '' %></td>
      <td class="drobno"><%= datum(o.ocenjeno) %></td>
    </tr>
    <% } %>
  </table>
  </div>
</div>
<% } %>

<%- include('../noga') %>
