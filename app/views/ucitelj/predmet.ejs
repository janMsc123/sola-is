<!-- ucitelj/predmet.ejs - ena skupina (predmet v razredu): naloge, gradiva, učenci, proste oddaje -->
<%- include('../glava', { naslov: skupina.predmet + ' ' + skupina.razred }) %>

<% const pot = '/ucitelj/predmet/' + skupina.predmet_id + '/razred/' + skupina.razred_id; %>

<div class="naslov-strani">
  <div>
    <a class="nazaj" href="/ucitelj">← Moji predmeti</a>
    <h1><%= skupina.predmet %></h1>
    <p class="podnaslov">Razred <%= skupina.razred %> · <%= ucenci.length %> učencev</p>
  </div>
</div>

<% if (napaka) { %>
  <p class="napaka"><%= napaka %></p>
<% } %>

<!-- ===== NALOGE ===== -->
<div class="okvir">
  <details>
    <summary class="okvir-glava">
      <h2>Naloge<span class="stevec"><%= naloge.length %></span></h2>
      <span class="gumb">Nova naloga</span>
    </summary>
    <form method="post" action="<%= pot %>/naloga" class="okvir-vsebina nova-naloga">
      <div class="dva-stolpca">
        <label>Naslov
          <input name="naslov" maxlength="100" placeholder="npr. Domača naloga 3" required>
        </label>
        <label>Rok oddaje
          <input type="datetime-local" name="rok" required>
        </label>
      </div>
      <label>Navodila
        <textarea name="navodila" rows="3" placeholder="Kaj morajo učenci narediti in oddati"></textarea>
      </label>
      <button type="submit">Razpiši nalogo</button>
    </form>
  </details>

  <% if (naloge.length === 0) { %>
    <p class="prazno">Še niste razpisali nobene naloge.</p>
  <% } else { %>
  <div class="tabela">
  <table>
    <tr><th>Naloga</th><th>Rok</th><th>Oddano</th><th>Ocenjeno</th></tr>
    <% for (const n of naloge) { %>
    <tr>
      <td><a href="/ucitelj/naloga/<%= n.id %>"><%= n.naslov %></a></td>
      <td>
        <%= datumUra(n.rok) %>
        <% if (new Date(n.rok) < zdaj) { %><span class="znacka">potekel</span><% } %>
      </td>
      <td class="st"><%= n.st_oddaj %> / <%= ucenci.length %></td>
      <td class="st"><%= n.st_ocenjenih %> / <%= n.st_oddaj %></td>
    </tr>
    <% } %>
  </table>
  </div>
  <% } %>
</div>

<!-- ===== GRADIVA ===== -->
<div class="okvir">
  <div class="okvir-glava">
    <h2>Gradiva<span class="stevec"><%= gradiva.length %></span></h2>
    <!-- enctype="multipart/form-data" je obvezen, če obrazec pošilja datoteko -->
    <form method="post" action="<%= pot %>/gradivo" enctype="multipart/form-data" class="vrstica">
      <input type="file" name="datoteka" required>
      <button type="submit">Naloži</button>
    </form>
  </div>

  <% if (gradiva.length === 0) { %>
    <p class="prazno">Ni še gradiv.</p>
  <% } else { %>
    <ul class="seznam">
      <% for (const g of gradiva) { %>
        <li>
          <div class="glavno">
            <a href="/ucitelj/gradivo/<%= g.id %>"><%= g.ime_datoteke %></a>
            <div class="drobno"><%= g.ime %> <%= g.priimek %><%= g.razred_id === null ? ' · vsi razredi' : '' %></div>
          </div>
          <span class="desno"><%= datum(g.nalozeno) %></span>
          <form method="post" action="/ucitelj/gradivo/<%= g.id %>/brisi"
                onsubmit="return confirm('Res želite izbrisati to gradivo?')">
            <input type="hidden" name="nazaj" value="<%= pot %>">
            <button class="rdec majhen">Briši</button>
          </form>
        </li>
      <% } %>
    </ul>
  <% } %>
</div>

<!-- ===== PROSTE ODDAJE ===== -->
<% if (proste.length > 0) { %>
<div class="okvir" id="proste">
  <div class="okvir-glava"><h2>Druge oddaje<span class="stevec"><%= proste.length %></span></h2><small>brez razpisane naloge</small></div>
  <div class="tabela">
  <table>
    <tr><th>Učenec</th><th>Datoteka</th><th>Ocena in komentar</th></tr>
    <% for (const o of proste) { %>
    <tr>
      <td><%= o.priimek %> <%= o.ime %></td>
      <td>
        <a href="/ucitelj/oddaja/<%= o.id %>"><%= o.ime_datoteke %></a>
        <div class="drobno"><%= datumUra(o.oddano) %></div>
      </td>
      <td><%- include('ocena-obrazec', { o: o }) %></td>
    </tr>
    <% } %>
  </table>
  </div>
</div>
<% } %>

<!-- ===== UČENCI ===== -->
<div class="okvir">
  <details>
    <summary class="okvir-glava">
      <h2>Učenci<span class="stevec"><%= ucenci.length %></span></h2>
      <span class="gumb siv">Pokaži</span>
    </summary>
    <ol class="stolpci">
      <% for (const u of ucenci) { %>
        <li><%= u.priimek %> <%= u.ime %></li>
      <% } %>
    </ol>
  </details>
</div>

<%- include('../noga') %>
