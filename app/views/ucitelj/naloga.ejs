<!-- ucitelj/naloga.ejs - ena naloga: navodila, kdo je oddal, kdo ne, ocenjevanje -->
<%- include('../glava', { naslov: naloga.naslov }) %>

<% const s = naloga.skupina; %>
<% const oddali = ucenci.filter(u => u.oddaja_id).length; %>
<% const ocenjeni = ucenci.filter(u => u.ocena).length; %>

<div class="naslov-strani">
  <div>
    <a class="nazaj" href="/ucitelj/predmet/<%= s.predmet_id %>/razred/<%= s.razred_id %>">← <%= s.predmet %> · <%= s.razred %></a>
    <h1><%= naloga.naslov %></h1>
  </div>
  <div class="vrstica">
    <a class="gumb siv" href="/ucitelj/naloga/<%= naloga.id %>/uredi">Uredi</a>
    <form method="post" action="/ucitelj/naloga/<%= naloga.id %>/brisi"
          onsubmit="return confirm('Res želite izbrisati nalogo? Izbrišejo se tudi vse oddaje učencev.')">
      <button class="rdec">Briši nalogo</button>
    </form>
  </div>
</div>

<% if (uspeh) { %>
  <p class="uspeh"><%= uspeh %></p>
<% } %>

<div class="okvir">
  <div class="okvir-vsebina">
    <div class="podatki">
      <div><span>Rok</span><b><%= datumUra(naloga.rok) %></b><% if (new Date(naloga.rok) < zdaj) { %> <span class="znacka">potekel</span><% } %></div>
      <div><span>Oddalo</span><b><%= oddali %> od <%= ucenci.length %></b></div>
      <div><span>Ocenjeno</span><b><%= ocenjeni %> od <%= oddali %></b></div>
    </div>
    <% if (naloga.navodila) { %>
      <p class="navodila"><%= naloga.navodila %></p>
    <% } %>
  </div>
</div>

<div class="okvir">
  <div class="okvir-glava"><h2>Oddaje učencev</h2></div>
  <div class="tabela">
  <table>
    <tr><th>Učenec</th><th>Stanje</th><th>Datoteka</th><th>Ocena in komentar</th></tr>
    <% for (const u of ucenci) { %>
    <% const st = stanje(u, naloga.rok, zdaj); %>
    <tr id="u<%= u.id %>">
      <td><%= u.priimek %> <%= u.ime %></td>
      <td><span class="stanje <%= st.barva %>"><%= st.besedilo %></span></td>
      <td>
        <% if (u.oddaja_id) { %>
          <a href="/ucitelj/oddaja/<%= u.oddaja_id %>"><%= u.ime_datoteke %></a>
          <div class="drobno"><%= datumUra(u.oddano) %></div>
        <% } else { %>
          <span class="drobno">ni oddaje</span>
        <% } %>
      </td>
      <td>
        <% if (u.oddaja_id) { %>
          <%- include('ocena-obrazec', { o: { id: u.oddaja_id, ocena: u.ocena, komentar: u.komentar } }) %>
        <% } %>
      </td>
    </tr>
    <% } %>
  </table>
  </div>
</div>

<%- include('../noga') %>
