<!-- ucitelj/domov.ejs - skupine (predmet + razred), ki jih učitelj poučuje, in prihajajoči roki -->
<%- include('../glava', { naslov: 'Moji predmeti' }) %>

<h1>Moji predmeti</h1>

<% if (skupine.length === 0) { %>
  <p>Ne poučujete nobenega predmeta. Obrnite se na administratorja.</p>
<% } %>

<div class="kartice">
  <% for (const s of skupine) { %>
    <a class="kartica" href="/ucitelj/predmet/<%= s.predmet_id %>/razred/<%= s.razred_id %>">
      <b><%= s.predmet %></b>
      <span class="oznaka modra"><%= s.razred %></span>
      <%= s.st_ucencev %> učencev · <%= s.st_nalog %> nalog
      <% if (s.st_neocenjenih > 0) { %>
        <br><span class="oznaka oranzna"><%= s.st_neocenjenih %> za oceniti</span>
      <% } %>
    </a>
  <% } %>
</div>

<h2>Prihajajoči roki</h2>

<% if (roki.length === 0) { %>
  <p>V naslednjih dneh nimate nobenega roka.</p>
<% } else { %>
  <ul class="roki">
    <% for (const n of roki) { %>
      <li>
        <span class="datum"><%= datumUra(n.rok) %></span>
        <a href="/ucitelj/naloga/<%= n.id %>"><%= n.naslov %></a>
        <small><%= n.predmet %>, <%= n.razred %> · oddaj: <%= n.st_oddaj %></small>
      </li>
    <% } %>
  </ul>
  <p><a href="/koledar">Odpri koledar →</a></p>
<% } %>

<%- include('../noga') %>
