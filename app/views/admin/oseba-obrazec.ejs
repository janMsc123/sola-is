<!-- admin/oseba-obrazec.ejs — dodajanje in urejanje učitelja ali učenca -->
<!-- če ima oseba id, urejamo; če nima, dodajamo novo -->
<%- include('../glava', { naslov: oseba.id ? 'Uredi' : 'Dodaj' }) %>

<div class="okvir">
  <h1><%= oseba.id ? 'Uredi ' + v.tozilnik : 'Nov ' + v.ednina %></h1>

  <% if (napaka) { %>
    <p class="napaka"><%= napaka %></p>
  <% } %>

  <form method="post" action="/admin/<%= vrsta %><%= oseba.id ? '/' + oseba.id : '' %>">
    <label>Ime
      <input name="ime" value="<%= oseba.ime || '' %>" required>
    </label>
    <label>Priimek
      <input name="priimek" value="<%= oseba.priimek || '' %>" required>
    </label>
    <label>Email
      <input type="email" name="email" value="<%= oseba.email || '' %>" required>
    </label>
    <label>
      <%= oseba.id ? 'Novo geslo (pustite prazno, če ga ne spreminjate)' : 'Geslo (vsaj 6 znakov)' %>
      <input type="password" name="geslo" <%= oseba.id ? '' : 'required' %>>
    </label>

    <!-- predmeti s kljukicami; obkljukani so tisti, ki so že izbrani -->
    <fieldset>
      <legend>
        <%= vrsta === 'ucitelji' ? 'Predmeti, ki jih poučuje' : 'Predmeti, ki jih obiskuje' %>
        (vsaj <%= v.najmanjPredmetov %>)
      </legend>
      <% for (const p of predmeti) { %>
        <label class="kljukica">
          <input type="checkbox" name="predmeti" value="<%= p.id %>"
            <%= izbrani.includes(String(p.id)) ? 'checked' : '' %>>
          <%= p.naziv %>
        </label>
      <% } %>
    </fieldset>

    <button type="submit">Shrani</button>
    <a href="/admin/<%= vrsta %>">Prekliči</a>
  </form>
</div>

<%- include('../noga') %>
