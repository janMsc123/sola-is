<!-- admin/oseba-obrazec.ejs - dodajanje in urejanje učitelja ali učenca -->
<!-- če ima oseba id, urejamo; če nima, dodajamo novo -->
<%- include('../glava', { naslov: oseba.id ? 'Uredi' : 'Dodaj' }) %>

<div class="naslov-strani">
  <div>
    <a class="nazaj" href="/admin/<%= vrsta %>">← <%= v.naslov %></a>
    <h1><%= oseba.id ? 'Uredi ' + v.tozilnik : 'Nov ' + v.ednina %></h1>
  </div>
</div>

<% if (napaka) { %>
  <p class="napaka"><%= napaka %></p>
<% } %>

<div class="okvir">
  <form method="post" action="/admin/<%= vrsta %><%= oseba.id ? '/' + oseba.id : '' %>" class="okvir-vsebina">
    <div class="dva-stolpca enaka">
      <label>Ime
        <input name="ime" value="<%= oseba.ime || '' %>" required>
      </label>
      <label>Priimek
        <input name="priimek" value="<%= oseba.priimek || '' %>" required>
      </label>
      <label>Email
        <input type="email" name="email" value="<%= oseba.email || '' %>" required>
      </label>
      <label>
        <%= oseba.id ? 'Novo geslo (prazno = ostane staro)' : 'Geslo (vsaj 6 znakov)' %>
        <input type="password" name="geslo" <%= oseba.id ? '' : 'required' %>>
      </label>
    </div>

    <% if (vrsta === 'ucitelji') { %>
      <!-- mreža: vrstice so predmeti, stolpci razredi; kljukica = učitelj uči ta predmet v tem razredu -->
      <fieldset>
        <legend>Kaj poučuje in v katerem razredu (vsaj 1)</legend>
        <div class="tabela">
        <table class="mreza">
          <tr>
            <th>Predmet</th>
            <% for (const r of razredi) { %><th><%= r.naziv %></th><% } %>
          </tr>
          <% for (const p of predmeti) { %>
          <tr>
            <td><%= p.naziv %></td>
            <% for (const r of razredi) { %>
              <% const kljuc = p.id + '-' + r.id; %>
              <td>
                <input type="checkbox" name="poucuje" value="<%= kljuc %>"
                  aria-label="<%= p.naziv %> <%= r.naziv %>"
                  <%= izbrani.includes(kljuc) ? 'checked' : '' %>>
              </td>
            <% } %>
          </tr>
          <% } %>
        </table>
        </div>
      </fieldset>

    <% } else { %>
      <label>Razred
        <select name="razred_id" required>
          <option value="">Izberite razred</option>
          <% for (const r of razredi) { %>
            <option value="<%= r.id %>" <%= String(oseba.razred_id) === String(r.id) ? 'selected' : '' %>><%= r.naziv %></option>
          <% } %>
        </select>
      </label>

      <!-- predmeti s kljukicami; obkljukani so tisti, ki so že izbrani -->
      <fieldset>
        <legend>Predmeti, ki jih obiskuje (vsaj <%= v.najmanjPredmetov %>)</legend>
        <% for (const p of predmeti) { %>
          <label class="kljukica">
            <input type="checkbox" name="predmeti" value="<%= p.id %>"
              <%= izbrani.includes(String(p.id)) ? 'checked' : '' %>>
            <%= p.naziv %>
          </label>
        <% } %>
      </fieldset>
    <% } %>

    <div class="vrstica">
      <button type="submit">Shrani</button>
      <a class="gumb siv" href="/admin/<%= vrsta %>">Prekliči</a>
    </div>
  </form>
</div>

<%- include('../noga') %>
