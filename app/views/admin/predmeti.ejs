<!-- admin/predmeti.ejs - seznam predmetov, dodajanje, urejanje, brisanje -->
<%- include('../glava', { naslov: 'Predmeti' }) %>

<div class="naslov-strani">
  <div>
    <h1>Predmeti</h1>
    <p class="podnaslov"><%= predmeti.length %> predmetov</p>
  </div>
  <!-- dodajanje novega predmeta -->
  <form method="post" action="/admin/predmeti" class="vrstica">
    <input name="naziv" placeholder="Nov predmet" required>
    <button type="submit">Dodaj</button>
  </form>
</div>

<% if (napaka) { %>
  <p class="napaka"><%= napaka %></p>
<% } %>

<div class="okvir">
  <div class="tabela">
  <table>
    <tr><th>Naziv</th><th>Učiteljev</th><th>Učencev</th><th></th></tr>
    <% for (const p of predmeti) { %>
    <tr>
      <td><%= p.naziv %></td>
      <td class="st"><%= p.st_uciteljev %></td>
      <td class="st"><%= p.st_ucencev %></td>
      <td class="gumbi">
        <a class="gumb siv majhen" href="/admin/predmeti/<%= p.id %>">Uredi</a>
        <!-- brisanje je POST obrazec, confirm() vpraša za potrditev -->
        <form method="post" action="/admin/predmeti/<%= p.id %>/brisi"
              onsubmit="return confirm('Res želite izbrisati predmet <%= p.naziv %>? Izbrišejo se tudi gradiva in naloge.')">
          <button class="rdec majhen">Briši</button>
        </form>
      </td>
    </tr>
    <% } %>
  </table>
  </div>
</div>

<%- include('../noga') %>
